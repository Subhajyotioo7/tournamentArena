pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQube Scanner'
                    withSonarQubeEnv('Sonar') {
                        sh """
                            "${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=tournament-arena \
                                -Dsonar.projectName=TournamentArena \
                                -Dsonar.sources=backend,frontend \
                                -Dsonar.python.version=3.12 \
                                -Dsonar.exclusions=backend/venv/**,backend/.venv/**,backend/media/**,backend/staticfiles/**,frontend/node_modules/**,frontend/dist/**,**/*.min.js
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'SonarQube pipeline finished.'
        }
    }
}
