# Backend Environment Variables for Production
# Copy this file to .env and fill in the values

# Django Settings
DJANGO_SECRET_KEY=your-super-secret-key-here-change-this-to-something-random
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,YOUR_EC2_PUBLIC_IP
DJANGO_SETTINGS_MODULE=backend.settings

# Database Configuration (PostgreSQL recommended for production)
DATABASE_URL=postgresql://tournament_user:YOUR_STRONG_PASSWORD@localhost:5432/tournament_arena

# Or for SQLite (not recommended for production)
# DATABASE_URL=sqlite:///db.sqlite3

# Redis Configuration (for WebSocket channels)
REDIS_URL=redis://localhost:6379/0

# CORS Settings
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com,http://YOUR_EC2_PUBLIC_IP

# Payment Gateway (Razorpay Standard Checkout)
# Copy these values from the Razorpay dashboard into backend/.env.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Amazon Cognito Hosted UI
COGNITO_DOMAIN=https://us-east-1zqtwscsvg.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=42vhcu9ibcqm6419oijik7q6m1
COGNITO_CLIENT_SECRET=1d75u7jtl176eej67t37it0b7lqp5plg7t7mbupo6ege72gdotc2
COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_YOUR_USER_POOL_ID
# Allows small clock differences between the local machine and Cognito.
COGNITO_JWT_LEEWAY_SECONDS=60

# PhonePe Payouts (requires separate payout product approval)
PHONEPE_PAYOUT_CLIENT_ID=your_phonepe_payout_client_id
PHONEPE_PAYOUT_CLIENT_SECRET=your_phonepe_payout_client_secret
PHONEPE_PAYOUT_CLIENT_VERSION=1
# Replace with the exact API URL from the PhonePe Payouts dashboard.
PHONEPE_PAYOUT_URL=
PHONEPE_PAYOUT_FEE=5.00
PHONEPE_PAYOUT_GST_RATE=18.00
# Development only: simulates a successful instant payout without calling PhonePe.
PHONEPE_PAYOUT_TEST_MODE=False

# Email Configuration (Optional - for password reset, notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# AWS S3 Configuration (Optional - for media files)
# USE_S3=True
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# Sentry (Optional - for error tracking)
# SENTRY_DSN=your-sentry-dsn-here

# Generate a new secret key with:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
