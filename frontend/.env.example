# Frontend Environment Variables for Production
# Copy this file to .env.production and configure for your server

# API Base URL - Point to your backend server
# Use your domain with HTTPS if SSL is configured
VITE_API_BASE_URL=https://your-domain.com

VITE_API_BASE_URL=http://localhost:8000
VITE_COGNITO_DOMAIN=https://us-east-1zqtwscsvg.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=42vhcu9ibcqm6419oijik7q6m1
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

# Or use EC2 public IP (without SSL)
# VITE_API_BASE_URL=http://YOUR_EC2_PUBLIC_IP:8000

# WebSocket URL (automatically determined from API URL in most cases)
# The application will use ws:// or wss:// based on http:// or https://
# No need to set this separately unless you have a custom WebSocket server
# VITE_WS_BASE_URL=wss://your-domain.com


# Analytics (Optional)
# VITE_GA_TRACKING_ID=your-google-analytics-id
# VITE_SENTRY_DSN=your-sentry-frontend-dsn

# Feature Flags (Optional)
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_DEBUG=false
